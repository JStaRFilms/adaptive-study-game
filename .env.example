# Copy to .env.local and fill in the values you use. Do not commit .env.local.
DATABASE_URL_POOLED=
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
AUTH_DEV_PASSWORD_ENABLED=true

# Optional until Google login is ready; both must be set to show its button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI remains unavailable until the database schema, quotas and launch controls are tested.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
AI_DAILY_USER_UNITS=
AI_DAILY_GLOBAL_UNITS=
AI_MAX_OUTPUT_TOKENS=
AI_API_ENABLED=false
